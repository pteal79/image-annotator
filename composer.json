{
    "name": "pteal79/image-annotator",
    "description": "NativePHP Mobile v4 plugin with a full-screen native image annotation editor for iOS and Android",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "mobile",
        "image",
        "annotation",
        "markup",
        "laravel"
    ],
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Pteal79\\ImageAnnotator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pteal79\\ImageAnnotator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:check": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pteal79\\ImageAnnotator\\ImageAnnotatorServiceProvider"
            ],
            "aliases": {
                "ImageAnnotator": "Pteal79\\ImageAnnotator\\Facades\\ImageAnnotator"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
